{
  "manifest_version": 3,
  "name": "CF7 Form Detector",
  "version": "1.0.0",
  "description": "Detect Contact Form 7 forms on the current page and open them directly in the WordPress admin, with Bedrock-aware admin URLs.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CF7 Form Detector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/shared/settings.js", "src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}